# Copy this file to .env and fill in real values for local reference only.
# The Flutter app itself never reads a .env file directly — these values
# are passed at build/run time via --dart-define (see README.md "Environment
# Configuration"). Never commit a real .env file.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase anon/publishable key. Safe to embed in a client app by design —
# Row Level Security is what actually protects data, not secrecy of this key.
SUPABASE_ANON_KEY=

# NEVER put SUPABASE_SERVICE_ROLE_KEY here or anywhere the Flutter app can
# read it. It is only used server-side (Edge Functions, scripts/import_content.dart
# run from a trusted machine/CI) and must never ship inside the app.

# ---------------------------------------------------------------------------
# AI Teacher — these are Supabase Edge Function secrets, NOT Flutter
# build/dart-define variables. Set them with:
#   supabase secrets set AI_PROVIDER=anthropic AI_MODEL=claude-sonnet-5 \
#     ANTHROPIC_API_KEY=... SUPABASE_URL=... SUPABASE_ANON_KEY=... \
#     SUPABASE_SERVICE_ROLE_KEY=...
# See docs/AI_TEACHER_GUIDE.md. The Flutter app never sees any of these —
# it only calls the ai-teacher Edge Function with the user's own session.
# ---------------------------------------------------------------------------

# Selects the provider adapter in supabase/functions/ai-teacher/index.ts.
# Currently supported: anthropic
AI_PROVIDER=anthropic

# Model name passed to the selected provider.
AI_MODEL=claude-sonnet-5

# The provider's own API key — server-side only, never in this file for
# real use, never in the Flutter app.
ANTHROPIC_API_KEY=

# Runtime limits (also configurable at runtime via the app_settings table
# without redeploying the function — see 007_ai_teacher.sql):
#   ai_daily_request_limit   — max AI Teacher requests per user per day
#   ai_max_prompt_chars      — max characters in one user message
#   ai_max_output_tokens     — max tokens the provider may generate
#   ai_request_timeout_ms    — provider call timeout
