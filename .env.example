# Copy this file to .env and fill in real values for local reference only.
# The Flutter app itself never reads a .env file directly — these values
# are passed at build/run time via --dart-define (see README.md "Environment
# Configuration"). Never commit a real .env file.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase anon/publishable key. Safe to embed in a client app by design —
# Row Level Security is what actually protects data, not secrecy of this key.
SUPABASE_ANON_KEY=

# NEVER put SUPABASE_SERVICE_ROLE_KEY here or anywhere the Flutter app can
# read it. It is only used server-side (Edge Functions, scripts/import_content.dart
# run from a trusted machine/CI) and must never ship inside the app.
